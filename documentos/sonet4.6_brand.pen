                      "name": "t3stars",
                      "fill": "#7A6A3E",
                      "content": "★★★★★",
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "7yY17",
                      "name": "t3quote",
                      "fill": "#2C2416",
                      "textGrowth": "fixed-width",
                      "width": 360,
                      "content": "&quot;La asesoría online fue perfecta. En una sola sesión resolvió todas mis dudas y me dio un plan claro. Vale muchísimo la pena.&quot;",

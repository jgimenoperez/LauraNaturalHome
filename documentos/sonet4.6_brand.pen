                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "lD5KT",
                      "name": "t2quote",
                      "fill": "#2C2416",
                      "textGrowth": "fixed-width",
                      "width": 360,
                      "content": "&quot;El home staging que hizo Laura fue clave para vender nuestro piso en tiempo récord y por encima del precio inicial. Una profesional de verdad.&quot;",
